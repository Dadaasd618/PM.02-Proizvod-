<Window x:Class="ClinicApp.Windows.AddEditDoctorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Врач" Height="473" Width="507" 
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F5F6FA">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2C3E50" Padding="15">
            <TextBlock x:Name="TitleText" Text="Добавление врача" FontSize="18" 
                       FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
        </Border>

        <StackPanel Grid.Row="1" Margin="20,15,20,5">
            <TextBlock Text="ФИО" FontWeight="SemiBold"/>
            <TextBox x:Name="FullNameBox" Padding="8" FontSize="14" Background="White"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="20,5">
            <TextBlock Text="Специальность" FontWeight="SemiBold"/>
            <TextBox x:Name="SpecialtyBox" Padding="8" FontSize="14" Background="White"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="20,5">
            <TextBlock Text="Кабинет" FontWeight="SemiBold"/>
            <TextBox x:Name="RoomBox" Padding="8" FontSize="14" Background="White"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="20,5">
            <TextBlock Text="Отделение (код)" FontWeight="SemiBold"/>
            <TextBox x:Name="DepartmentBox" Padding="8" FontSize="14" Background="White"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,20">
            <Button Content="✅ Сохранить" Width="120" Height="40" Click="Save_Click" 
                    Background="#27AE60" Foreground="White" FontWeight="Bold" FontSize="14"
                    BorderThickness="0" Cursor="Hand" Margin="5"/>
            <Button Content="❌ Отмена" Width="120" Height="40" Click="Cancel_Click" 
                    Background="#E74C3C" Foreground="White" FontWeight="Bold" FontSize="14"
                    BorderThickness="0" Cursor="Hand" Margin="5"/>
        </StackPanel>
    </Grid>
</Window>