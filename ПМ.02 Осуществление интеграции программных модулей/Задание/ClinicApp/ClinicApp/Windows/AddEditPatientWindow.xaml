<Window x:Class="ClinicApp.Windows.AddEditPatientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Пациент" Height="596" Width="508" 
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F5F6FA">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2C3E50" Padding="15">
            <TextBlock x:Name="TitleText" Text="Добавление пациента" FontSize="18" 
                       FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
        </Border>

        <StackPanel Grid.Row="1" Margin="20,15,20,5">
            <TextBlock Text="ФИО" FontWeight="SemiBold" Margin="0,0,0,2"/>
            <TextBox x:Name="FullNameBox" Padding="8" FontSize="14" Background="White"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="20,5">
            <TextBlock Text="Дата рождения" FontWeight="SemiBold" Margin="0,0,0,2"/>
            <DatePicker x:Name="BirthDatePicker" Padding="8" FontSize="14" Background="White"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="20,5">
            <TextBlock Text="Полис (16 цифр)" FontWeight="SemiBold" Margin="0,0,0,2"/>
            <TextBox x:Name="PolicyBox" Padding="8" FontSize="14" Background="White" MaxLength="16"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="20,5">
            <TextBlock Text="Телефон" FontWeight="SemiBold" Margin="0,0,0,2"/>
            <TextBox x:Name="PhoneBox" Padding="8" FontSize="14" Background="White"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Margin="20,5">
            <TextBlock Text="Логин (для входа)" FontWeight="SemiBold" Margin="0,0,0,2"/>
            <TextBox x:Name="LoginBox" Padding="8" FontSize="14" Background="White"/>
        </StackPanel>

        <StackPanel Grid.Row="6" Margin="20,5">
            <TextBlock Text="Пароль (для входа)" FontWeight="SemiBold" Margin="0,0,0,2"/>
            <PasswordBox x:Name="PasswordBox" Padding="8" FontSize="14" Background="White"/>
        </StackPanel>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,10">
            <Button Content="✅ Сохранить" Width="120" Height="40" Click="Save_Click" 
                    Background="#27AE60" Foreground="White" FontWeight="Bold" FontSize="14"
                    BorderThickness="0" Cursor="Hand" Margin="5"/>
            <Button Content="❌ Отмена" Width="120" Height="40" Click="Cancel_Click" 
                    Background="#E74C3C" Foreground="White" FontWeight="Bold" FontSize="14"
                    BorderThickness="0" Cursor="Hand" Margin="5"/>
        </StackPanel>

        <TextBlock Grid.Row="8" x:Name="ErrorText" Foreground="Red" HorizontalAlignment="Center" Margin="0,0,0,10"/>
    </Grid>
</Window>