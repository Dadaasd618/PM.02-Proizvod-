<Window x:Class="ClinicApp.Windows.AddEditServiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Услуга" Height="420" Width="550" 
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F5F6FA">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2C3E50" Padding="15">
            <TextBlock x:Name="TitleText" Text="Добавление услуги" FontSize="18" 
                       FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
        </Border>

        <StackPanel Grid.Row="1" Margin="20,15,20,5">
            <TextBlock Text="Наименование услуги" FontWeight="SemiBold" Margin="0,0,0,2"/>
            <TextBox x:Name="NameBox" Padding="8" FontSize="14" Background="White"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="20,5">
            <TextBlock Text="Цена (₽)" FontWeight="SemiBold" Margin="0,0,0,2"/>
            <TextBox x:Name="PriceBox" Padding="8" FontSize="14" Background="White"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="20,5">
            <TextBlock Text="Код МКБ-10 (диагноз)" FontWeight="SemiBold" Margin="0,0,0,2"/>
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="IcdCodeBox" Padding="8" FontSize="14" Background="White" Width="180" Margin="0,0,10,0" MaxLength="10"/>
                <Button Content="Проверить МКБ-10" Width="140" Height="35" Click="CheckIcdCode_Click" 
                        Background="#3498DB" Foreground="White" FontWeight="Bold" FontSize="12"
                        BorderThickness="0" Cursor="Hand"/>
                <TextBlock x:Name="IcdResultText" Margin="10,5,0,0" VerticalAlignment="Center" 
                           Foreground="#2C3E50" FontWeight="SemiBold" TextWrapping="Wrap" Width="150"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button Content="Сохранить" Width="120" Height="40" Click="Save_Click" 
                    Background="#27AE60" Foreground="White" FontWeight="Bold" FontSize="14"
                    BorderThickness="0" Cursor="Hand" Margin="5"/>
            <Button Content="Отмена" Width="120" Height="40" Click="Cancel_Click" 
                    Background="#E74C3C" Foreground="White" FontWeight="Bold" FontSize="14"
                    BorderThickness="0" Cursor="Hand" Margin="5"/>
        </StackPanel>

        <TextBlock Grid.Row="5" x:Name="ErrorText" Foreground="Red" HorizontalAlignment="Center" Margin="0,5,0,10" FontSize="13"/>
    </Grid>
</Window>