<Window x:Class="ClinicApp.Windows.CompleteServiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="✅ Оказание услуги" Height="438" Width="506" 
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F5F6FA">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2C3E50" Padding="15">
            <TextBlock Text="✅ Оказание услуги" FontSize="18" 
                       FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
        </Border>

        <StackPanel Grid.Row="1" Margin="20,20,20,10" Background="White">
            <TextBlock Text="👨‍⚕️ Врач:" FontWeight="SemiBold" FontSize="14"/>
            <TextBlock x:Name="DoctorNameText" FontSize="14" Margin="0,0,0,15" Foreground="#2C3E50"/>

            <TextBlock Text="📋 Выберите приём для подтверждения:" FontWeight="SemiBold" FontSize="14" Margin="0,10,0,5"/>
            <ComboBox x:Name="OrderCombo" Height="35" FontSize="14" Margin="0,0,0,15"/>

            <TextBlock Text="💊 Информация:" FontWeight="SemiBold" FontSize="14" Margin="0,10,0,5"/>
            <Border Background="#F8F9FA" Padding="10" CornerRadius="5">
                <TextBlock x:Name="InfoText" Text="Выберите приём для просмотра информации" FontSize="13" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
            <Button Content="✅ Подтвердить" Width="140" Height="40" Click="Confirm_Click" 
                    Background="#27AE60" Foreground="White" FontWeight="Bold" FontSize="14"
                    BorderThickness="0" Cursor="Hand" Margin="5"/>
            <Button Content="❌ Отмена" Width="140" Height="40" Click="Cancel_Click" 
                    Background="#E74C3C" Foreground="White" FontWeight="Bold" FontSize="14"
                    BorderThickness="0" Cursor="Hand" Margin="5"/>
        </StackPanel>
    </Grid>
</Window>