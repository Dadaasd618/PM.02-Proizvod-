<Window x:Class="ClinicApp.Windows.BookAppointmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="📝 Запись на приём" Height="570" Width="504" 
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F5F6FA">

    <Grid Margin="0,0,0,-6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2C3E50" Padding="15">
            <TextBlock Text="📝 Запись на приём" FontSize="18" 
                       FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
        </Border>

        <StackPanel Grid.Row="1" Margin="20,20,20,10" Background="White">
            <TextBlock Text="👤 Пациент:" FontWeight="SemiBold" FontSize="14"/>
            <TextBlock x:Name="PatientNameText" FontSize="14" Margin="0,0,0,15" Foreground="#2C3E50"/>

            <TextBlock Text="💊 Выберите услугу:" FontWeight="SemiBold" FontSize="14" Margin="0,10,0,5"/>
            <ComboBox x:Name="ServiceCombo" Height="35" FontSize="14" Margin="0,0,0,15"/>

            <TextBlock Text="👨‍⚕️ Выберите врача:" FontWeight="SemiBold" FontSize="14" Margin="0,10,0,5"/>
            <ComboBox x:Name="DoctorCombo" Height="35" FontSize="14" Margin="0,0,0,15"/>

            <TextBlock Text="📅 Дата:" FontWeight="SemiBold" FontSize="14" Margin="0,10,0,5"/>
            <DatePicker x:Name="DatePicker" Height="35" FontSize="14" Margin="0,0,0,10"/>

            <TextBlock Text="🕐 Время:" FontWeight="SemiBold" FontSize="14" Margin="0,10,0,5"/>
            <ComboBox x:Name="TimeCombo" Height="35" FontSize="14" Margin="0,0,0,10">
                <ComboBoxItem>09:00</ComboBoxItem>
                <ComboBoxItem>10:00</ComboBoxItem>
                <ComboBoxItem>11:00</ComboBoxItem>
                <ComboBoxItem>12:00</ComboBoxItem>
                <ComboBoxItem>13:00</ComboBoxItem>
                <ComboBoxItem>14:00</ComboBoxItem>
                <ComboBoxItem>15:00</ComboBoxItem>
                <ComboBoxItem>16:00</ComboBoxItem>
                <ComboBoxItem>17:00</ComboBoxItem>
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
            <Button Content="✅ Записаться" Width="140" Height="40" Click="Save_Click" 
                    Background="#27AE60" Foreground="White" FontWeight="Bold" FontSize="14"
                    BorderThickness="0" Cursor="Hand" Margin="5"/>
            <Button Content="❌ Отмена" Width="140" Height="40" Click="Cancel_Click" 
                    Background="#E74C3C" Foreground="White" FontWeight="Bold" FontSize="14"
                    BorderThickness="0" Cursor="Hand" Margin="5"/>
        </StackPanel>
    </Grid>
</Window>